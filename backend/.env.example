# Lokal (docker compose): kedua URL boleh sama
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobapp?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jobapp?schema=public"
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN="7d"
PORT=4000
# Boleh lebih dari satu, pisahkan dengan koma
CORS_ORIGIN="http://localhost:5173"

# --- Produksi (Vercel + Supabase) ---
# DATABASE_URL = Supabase Transaction pooler (port 6543), tambahkan ?pgbouncer=true
# DIRECT_URL   = Supabase Session pooler (port 5432), dipakai untuk migrate/seed
